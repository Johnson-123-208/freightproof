{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://freightproof-api.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://freightproof-api.onrender.com/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
