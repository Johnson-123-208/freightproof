# Backend (optional — defaults to SQLite file backend/freightproof.db)
DATABASE_URL=sqlite:///./freightproof.db
CORS_ORIGINS=http://localhost:5178,http://127.0.0.1:5178

# Optional Supabase (leave unset for local SQLite demo)
SUPABASE_URL=
SUPABASE_KEY=

# Frontend (optional — dev uses Vite proxy when unset)
VITE_API_URL=